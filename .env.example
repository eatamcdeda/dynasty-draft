# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.

# App URL used in Stripe success/cancel redirects.
# Preview server defaults to 4173; `next dev` should use 3000.
APP_URL=http://127.0.0.1:4173
UNLOCK_SECRET=

# Stripe (dashboard.stripe.com) — same one-time Checkout pattern as Playlist Finder.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a one-time Price ID. If omitted, Checkout uses $9.99 USD.
# If you set this, the Stripe product must have a Managed Payments–eligible tax code
# (for example SaaS – personal use: txcd_10103000).
# STRIPE_PRICE_ID=
# STRIPE_TAX_CODE=txcd_10103000
STRIPE_UNLOCK_AMOUNT_CENTS=999
# STRIPE_UNLOCK_CURRENCY=usd

# Local UI testing only. Do not set this on Vercel/production.
# SKIP_PAYWALL=true
